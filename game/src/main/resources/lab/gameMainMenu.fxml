<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.layout.VBox?>
<BorderPane fx:id="mainMenu" fx:controller="lab.MainMenuController" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
    <center>
        <VBox alignment="CENTER" spacing="20">

            <Button fx:id="scoreboard" mnemonicParsing="false"
                    style="-fx-background-color: #8aa3b1;"
                    text="SCOREBOARD" textAlignment="CENTER" textFill="WHITE"
                    onAction="#openScoreboard">
                <font>
                    <Font name="System Bold" size="12.0" />
                </font>
            </Button>

            <Button fx:id="load" mnemonicParsing="false"
                    style="-fx-background-color: #8aa3b1;"
                    text="LOAD GAME" textAlignment="CENTER" textFill="WHITE"
                    onAction="#onLoadGame">
                <font>
                    <Font name="System Bold" size="12.0" />
                </font>
            </Button>

            <Button fx:id="play" mnemonicParsing="false"
                    style="-fx-background-color: #8aa3b1;"
                    text="PLAY" textAlignment="CENTER" textFill="WHITE"
                    onAction="#startGame">
                <font>
                    <Font name="System Bold" size="12.0" />
                </font>
            </Button>

        </VBox>
    </center>
   <top>
      <Label styleClass="arcadeText" style="-fx-font-size: 100px;" text="ASTEROIDS" textFill="WHITE" BorderPane.alignment="CENTER"/>
   </top>
</BorderPane>
