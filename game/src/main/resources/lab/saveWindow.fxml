<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="saveWindow" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lab.SaveWindowController">

    <center>
        <VBox alignment="CENTER" spacing="25">

            <Label style="-fx-font-size: 75px;" styleClass="arcadeText" text="Create a SAVE" />

            <TextField fx:id="nameField" maxWidth="250" prefHeight="35" promptText="Enter your name" />

            <TextField fx:id="descriptionField" maxWidth="250" prefHeight="35" promptText="Enter save description" />

            <Button fx:id="exit" mnemonicParsing="false" onAction="#onButtonSave" style="-fx-background-color: #8aa3b1;" text="EXIT" textAlignment="CENTER" textFill="WHITE" BorderPane.alignment="CENTER">
                <font>
                    <Font name="System Bold" size="12.0" />
                </font>
            </Button>

        </VBox>
    </center>

</BorderPane>