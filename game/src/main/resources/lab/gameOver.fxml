<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="gameOver" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lab.GameOverController">

    <center>
        <VBox alignment="CENTER" spacing="25">

            <Label style="-fx-font-size: 100px;" styleClass="arcadeText" text="GAME OVER!" />

            <Label fx:id="finalScore" style="-fx-font-size: 32px;" styleClass="arcadeText" textFill="WHITE" />

            <TextField fx:id="nameField" maxWidth="250" prefHeight="35" promptText="Enter your name" />


            <Button fx:id="exit" mnemonicParsing="false" onAction="#onBackToMenu" style="-fx-background-color: #8aa3b1;" text="EXIT" textAlignment="CENTER" textFill="WHITE" BorderPane.alignment="CENTER">
                <font>
                    <Font name="System Bold" size="12.0" />
                </font>
            </Button>
        </VBox>
    </center>

</BorderPane>
